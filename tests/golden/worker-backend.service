# Generated by sgbc. Edits are overwritten on the next deploy.
[Unit]
Description=akwaaba-indexer backend (Solana Ghana Builder Cloud)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=akwaaba-indexer
Group=akwaaba-indexer
WorkingDirectory=/srv/solanaghana/projects/akwaaba-indexer/backend
ExecStart=/bin/sh -lc './target/release/akwaaba-indexer'
Restart=on-failure
RestartSec=5

Environment=NODE_ENV=production

StandardOutput=append:/srv/solanaghana/logs/akwaaba-indexer/backend.log
StandardError=append:/srv/solanaghana/logs/akwaaba-indexer/backend.log

# The host is shared, so a builder's process is confined to its own
# project directory and is given no route to privilege.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
ReadWritePaths=/srv/solanaghana/projects/akwaaba-indexer /srv/solanaghana/logs/akwaaba-indexer

# A runaway build or leak must not take the host down with it.
MemoryMax=512M
TasksMax=256

[Install]
WantedBy=multi-user.target
