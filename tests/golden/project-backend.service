# Generated by sgbc. Edits are overwritten on the next deploy.
[Unit]
Description=my-solana-project backend (Solana Ghana Builder Cloud)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=my-solana-project
Group=my-solana-project
WorkingDirectory=/srv/solanaghana/projects/my-solana-project/backend
ExecStart=/bin/sh -lc 'npm run start'
Restart=on-failure
RestartSec=5

Environment=NODE_ENV=production
Environment=PORT=8080

StandardOutput=append:/srv/solanaghana/logs/my-solana-project/backend.log
StandardError=append:/srv/solanaghana/logs/my-solana-project/backend.log

# The host is shared, so a builder's process is confined to its own
# project directory and is given no route to privilege.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
ReadWritePaths=/srv/solanaghana/projects/my-solana-project /srv/solanaghana/logs/my-solana-project

# A runaway build or leak must not take the host down with it.
MemoryMax=512M
TasksMax=256

[Install]
WantedBy=multi-user.target
